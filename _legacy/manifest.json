{
  "manifest_version": 3,
  "name": "DevLens",
  "version": "1.0.0",
  "description": "이미지 EXIF 정보 확인 및 다운로드 도구",
  "permissions": [
    "activeTab",
    "downloads",
    "contextMenus",
    "sidePanel",
    "storage",
    "offscreen",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["sniffer.js"],
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "DevLens 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
